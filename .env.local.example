# Ejaza — environment variables. Copy to .env.local and fill in.
# .env*.local is git-ignored — never put real secrets in THIS file, it is
# committed to the repo as a template.

# Client-safe (exposed to the browser bundle):
NEXT_PUBLIC_SUPABASE_URL=http://localhost:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# SERVER-ONLY. Must never be prefixed with NEXT_PUBLIC_ and never imported into
# a client component. Bypasses RLS — used only in trusted server code.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
